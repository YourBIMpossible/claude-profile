// Tier 1 skill-detection hook.
// Paste this object as a NEW entry in the existing "hooks" -> "PostToolUse" array
// in C:\Users\Zeria\.claude\settings.json (alongside the context_budget entry -
// do not replace it). Then open /hooks once, or restart, to load it.
{
  "matcher": "mcp__mcp-server-for-revit__send_code_to_revit",
  "hooks": [
    {
      "type": "prompt",
      "prompt": "You decide whether Revit C# just executed via MCP contains a REUSABLE pattern worth capturing as a Claude Code skill.\n\nTool call JSON:\n$ARGUMENTS\n\nAnswer ok=true (take no action) in ALL of these cases:\n- Simple read, query, count, or listing.\n- One-off exploration or a debugging probe.\n- The call failed, errored, or returned an error string.\n- It is executing a workflow an existing skill already documents: per-sector viewport/template alignment, grid bubble extents, annotation crops, viewport titles, sheet or view creation, scope box assignment, print sets, bulk sheet parameters, renaming.\n- Trivial glue with no non-obvious API knowledge.\n\nAnswer ok=false ONLY for genuinely hard-won reusable knowledge: a non-obvious Revit API gotcha or workaround, a multi-step operation with ordering or transaction constraints that is easy to get wrong, or a batch workflow the user would plausibly re-run on another model.\n\nWhen ok=false, set reason to exactly: \"SKILL-WORTHY PATTERN: <one sentence naming the specific reusable technique>. Ask the user whether to capture this as a skill before the session ends.\" Name the actual technique - never a generic description.\n\nBias hard toward ok=true. A false flag costs the user attention; a missed pattern costs nothing, since they can always ask.",
      "continueOnBlock": true,
      "timeout": 30,
      "statusMessage": "Checking for skill-worthy pattern"
    }
  ]
}
